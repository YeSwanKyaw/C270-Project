services:
  mysql:
    image: mysql:8.4
    container_name: aac-mysql
    ports:
      - "{{ mysql_port | default(3306) }}:3306"
    environment:
      MYSQL_ROOT_PASSWORD: "{{ mysql_root_password | default('rootpass') }}"
      MYSQL_DATABASE: "{{ mysql_database | default('answer_and_conquer') }}"
      MYSQL_USER: "{{ mysql_user | default('aac') }}"
      MYSQL_PASSWORD: "{{ mysql_password | default('aacpass') }}"
    volumes:
      - aac-mysql:/var/lib/mysql
      - ./sql/database.sql:/docker-entrypoint-initdb.d/01-database.sql:ro
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "127.0.0.1", "-u{{ mysql_user | default('aac') }}", "-p{{ mysql_password | default('aacpass') }}"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 30s
    restart: unless-stopped

  bot-api:
    image: {{ full_bot_image }}
    container_name: {{ bot_container_name }}
    ports:
      - "{{ bot_port }}:5050"
    env_file:
      - .env
    environment:
      FLASK_DEBUG: "false"
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:5050/health')"]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 10s

  web:
    image: {{ full_web_image }}
    container_name: {{ web_container_name }}
    ports:
      - "{{ web_port }}:3000"
    env_file:
      - .env
    environment:
      WEB_PORT: "{{ web_port }}"
      BOT_API_BASE: "http://{{ bot_container_name }}:5050"
      DB_HOST: mysql
      DB_PORT: "3306"
      DB_USER: "{{ mysql_user | default('aac') }}"
      DB_PASSWORD: "{{ mysql_password | default('aacpass') }}"
      DB_NAME: "{{ mysql_database | default('answer_and_conquer') }}"
      QUESTIONS_PATH: /questions.json
    depends_on:
      mysql:
        condition: service_healthy
      bot-api:
        condition: service_healthy
    restart: unless-stopped

volumes:
  aac-mysql:
