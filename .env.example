# Flask bot API (optional for Smart AI)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
FLASK_DEBUG=false
BOT_API_BASE=http://127.0.0.1:5050

# Web app
WEB_PORT=3000
NODE_ENV=development

# Session cookie (BillReminder-style — any long random string)
SESSION_SECRET=change-this-to-a-long-random-string

# MySQL — same style as BillReminder (import database.sql in Workbench first)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=answer_and_conquer
# Set DB_SSL=true for Azure MySQL (auto-enabled for *.mysql.database.azure.com)
# DB_SSL=true
